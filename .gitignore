# Rust build artifacts
target/

# Generated TLS material — the proxy mints a self-signed cert at startup when
# none is present. None of this belongs in version control.
*.p12
*.crt
*.key
*.pem

# Notebooks: committed outputs leak environment details and stale benchmark
# numbers. Benchmarks live in bench/ and write BENCHMARK.md.
*.ipynb

# Runtime logs
*.log
prism.log
haproxy.log

# Benchmark output. The harness writes here; the top-level BENCHMARK.md is
# updated by hand from it, so no run can put numbers into the repository by
# accident.
bench/results/

# Python
__pycache__/
*.py[cod]
*.so
.env
.venv
env/
venv/
